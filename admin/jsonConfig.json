{
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": "General Settings",
      "items": {
        "cmiName": {
          "type": "text",
          "label": "CMI Name",
          "help": "Name of your CMI device (e.g., cmi088364)",
          "placeholder": "cmi088364"
        },
        "email": {
          "type": "text",
          "label": "Email",
          "help": "Your login email for the CMI portal"
        },
        "password": {
          "type": "password",
          "label": "Password",
          "help": "Your login password for the CMI portal"
        },
        "pollInterval": {
          "type": "number",
          "label": "Poll Interval (ms)",
          "help": "How often to poll for new data in milliseconds",
          "min": 60000,
          "max": 300000,
          "default": 60000
        },
        "pollSetback": {
          "type": "checkbox",
          "label": {
            "en": "Poll night setback",
            "de": "Nachtabsenkung abfragen"
          },
          "help": {
            "en": "Reads sensors.nachtabsenkung from 1.cgi. Causes an additional request to the CMI per poll interval.",
            "de": "Liest sensors.nachtabsenkung aus 1.cgi. Verursacht pro Abfrageintervall eine zusätzliche Anfrage an das CMI."
          },
          "default": true
        }
      }
    },
    "logging": {
      "type": "panel",
      "label": {
        "en": "Logging profiles",
        "de": "Logging-Profile"
      },
      "items": {
        "loggingProfiles": {
          "type": "table",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "label": {
            "en": "Logging profiles",
            "de": "Logging-Profile"
          },
          "help": {
            "en": "Each profile is read from the CMI portal in its own refresh interval (one request per profile). Values appear under logging.<profile name>.",
            "de": "Jedes Profil wird im eigenen Aktualisierungsintervall aus dem CMI-Portal gelesen (eine Anfrage pro Profil). Die Werte erscheinen unter logging.<Profilname>."
          },
          "items": [
            {
              "type": "text",
              "attr": "name",
              "width": "40%",
              "title": {
                "en": "Profile name",
                "de": "Profilname"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "text",
              "attr": "creator",
              "width": "35%",
              "title": {
                "en": "Creator",
                "de": "Creator-Name"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "number",
              "attr": "interval",
              "width": "25%",
              "title": {
                "en": "Refresh (min)",
                "de": "Intervall (min)"
              },
              "min": 1,
              "default": 5,
              "filter": false,
              "sort": false
            }
          ]
        }
      }
    },
    "can": {
      "type": "panel",
      "label": {
        "en": "CAN inputs (CoE)",
        "de": "CAN-Eingänge (CoE)"
      },
      "items": {
        "cmiIp": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "label": {
            "en": "Local IP of the CMI",
            "de": "Lokale IP des CMI"
          },
          "help": {
            "en": "CoE packets are sent to this address (UDP port 5442). In the CMI, CoE version 2 must be selected.",
            "de": "An diese Adresse werden die CoE-Pakete gesendet (UDP-Port 5442). Im CMI muss CoE-Version 2 eingestellt sein."
          },
          "placeholder": "192.168.1.50"
        },
        "coeResendInterval": {
          "type": "number",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "min": 0,
          "max": 60,
          "label": {
            "en": "Resend interval (min)",
            "de": "Wiederholintervall (min)"
          },
          "help": {
            "en": "Values are sent again regularly so that the CAN inputs don't run into their timeout. 0 = only on change.",
            "de": "Die Werte werden regelmäßig erneut gesendet, damit die CAN-Eingänge nicht in ihren Timeout laufen. 0 = nur bei Änderung."
          }
        },
        "canInputs": {
          "type": "table",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "label": {
            "en": "CAN inputs",
            "de": "CAN-Eingänge"
          },
          "help": {
            "en": "Node and output as set in the CAN input of the controller. Each input appears as writable state can.<name>; setting it sends the value via CoE. The unit only applies to analog inputs.",
            "de": "Knoten- und Ausgangsnummer wie im CAN-Eingang des Reglers eingestellt. Jeder Eingang erscheint als beschreibbarer State can.<Name>; beim Setzen wird der Wert per CoE gesendet. Die Einheit gilt nur für analoge Eingänge."
          },
          "items": [
            {
              "type": "text",
              "attr": "name",
              "width": "25%",
              "title": {
                "en": "Name",
                "de": "Name"
              },
              "filter": false,
              "sort": false
            },
            {
              "type": "select",
              "attr": "type",
              "width": "15%",
              "title": {
                "en": "Type",
                "de": "Typ"
              },
              "default": "analog",
              "filter": false,
              "sort": false,
              "options": [
                {
                  "label": {
                    "en": "analog",
                    "de": "analog"
                  },
                  "value": "analog"
                },
                {
                  "label": {
                    "en": "digital",
                    "de": "digital"
                  },
                  "value": "digital"
                }
              ]
            },
            {
              "type": "number",
              "attr": "node",
              "width": "15%",
              "title": {
                "en": "Node",
                "de": "Knotennummer"
              },
              "min": 1,
              "max": 62,
              "default": 42,
              "filter": false,
              "sort": false
            },
            {
              "type": "number",
              "attr": "output",
              "width": "15%",
              "title": {
                "en": "Output",
                "de": "Ausgangsnummer"
              },
              "min": 1,
              "max": 64,
              "default": 1,
              "filter": false,
              "sort": false
            },
            {
              "type": "select",
              "attr": "unit",
              "width": "30%",
              "title": {
                "en": "Unit",
                "de": "Einheit"
              },
              "default": 1,
              "filter": false,
              "sort": false,
              "options": [
                {
                  "label": "dimensionslos",
                  "value": 0
                },
                {
                  "label": "dimensionslos (0,1)",
                  "value": 58
                },
                {
                  "label": "°C",
                  "value": 1
                },
                {
                  "label": "K",
                  "value": 7
                },
                {
                  "label": "%",
                  "value": 8
                },
                {
                  "label": "W/m²",
                  "value": 2
                },
                {
                  "label": "l/h",
                  "value": 3
                },
                {
                  "label": "l/min",
                  "value": 22
                },
                {
